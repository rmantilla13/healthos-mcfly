# WHOOP developer app credentials (create an app at https://developer.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must exactly match a redirect URL registered on your WHOOP app
WHOOP_REDIRECT_URI=http://localhost:8787/api/whoop/callback

# iPhone app (ios/): shared secret for POST /api/apple/ingest. Unset = ingest off.
# Generate one with: openssl rand -hex 24
HEALTHOS_INGEST_TOKEN=
# Opt-in LAN mode: a second port, reachable from your phone, that serves only the ingest endpoint
# HEALTHOS_LAN=1
# HEALTHOS_LAN_PORT=8788

# Optional
# PORT=8787
# HEALTHOS_DATA_DIR=./data

# Hosted database (Neon Postgres). `vercel env pull .env.local` fills this in from the healthos project.
# Unset = a local Postgres (PGlite) under data/pglite.
# DATABASE_URL=

# Hosted sign-in (set on Vercel by scripts/setup-vercel.sh; not needed locally)
# HEALTHOS_PASSWORD_HASH=
# SESSION_SECRET=
# CRON_SECRET=

# Your own AI keys (Profile → Chatbot, OpenAI · Nutrition & portraits) are stored encrypted with this key.
# Unset = people can't store keys, and everyone uses the shared ANTHROPIC_API_KEY as before.
# Generate once with: openssl rand -hex 32. Never rotate it without re-entering keys: stored ones become unreadable.
# HEALTHOS_DATA_KEY=
# Optional: a server OpenAI key for voice notes and portraits when a person has none of their own.
# OPENAI_API_KEY=
